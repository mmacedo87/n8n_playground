                  },
                  {
                    "option": "1-2 mm"
                  },
                  {
                    "option": "2-4 mm"
                  },
                  {
                    "option": "4-8 mm"
                  },
                  {
                    "option": "8-15 mm"
                  }
                ]
              }
            },
            {
              "fieldName": "quantidade",
              "fieldLabel": "Quantidade (kg)",
