              "fieldLabel": "Morada de carga",
              "fieldType": "text",
              "placeholder": "Local e código postal",
              "requiredField": false
            },
            {
              "fieldName": "morada_descarga",
              "fieldLabel": "Morada de descarga",
              "fieldType": "text",
              "placeholder": "Local e código postal",
