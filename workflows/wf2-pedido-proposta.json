              "placeholder": "ex. 28100",
              "requiredField": false
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Registar pedido",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Pedido registado. Vai receber um email de confirmação com o número da proposta."
            }
          }
        }
      }
    },
    {
      "id": "5a150f3c-4254-415e-a780-98b7b1c926b0",
      "name": "Normalizar pedido",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "n-cliente",
              "name": "cliente",
              "type": "string",
              "value": "={{ String($json.cliente ?? $json.Cliente ?? \"\").trim().slice(0, 200) }}"
            },
            {
              "id": "n-produto",
              "name": "produto",
              "type": "string",
              "value": "={{ String($json.produto ?? $json.Produto ?? \"\").trim().slice(0, 100) }}"
            },
            {
              "id": "n-densidade",
              "name": "densidade",
              "type": "string",
              "value": "={{ String($json.densidade ?? $json.Densidade ?? \"\").trim().slice(0, 100) }}"
            },
            {
              "id": "n-granulometria",
              "name": "granulometria",
              "type": "string",
              "value": "={{ String($json.granulometria ?? $json.Granulometria ?? \"\").trim().slice(0, 100) }}"
            },
            {
              "id": "n-quantidade",
              "name": "quantidade",
              "type": "number",
              "value": "={{ Number($json.quantidade ?? $json[\"Quantidade (kg)\"]) }}"
            },
            {
              "id": "n-embalagem",
              "name": "embalagem",
              "type": "string",
              "value": "={{ String($json.embalagem ?? $json.Embalagem ?? \"\").trim().slice(0, 100) }}"
            },
            {
              "id": "n-incoterm",
              "name": "incoterm",
              "type": "string",
              "value": "={{ String($json.incoterm ?? $json.Incoterm ?? \"\").trim().toUpperCase().slice(0, 10) }}"
            },
            {
              "id": "n-destino",
              "name": "destino",
              "type": "string",
              "value": "={{ String($json.destino ?? $json[\"Destino (país)\"] ?? \"\").split(\" - \")[0].trim().toUpperCase().slice(0, 10) }}"
            },
            {
              "id": "n-destinatario",
              "name": "destinatario_confirmacao",
              "type": "string",
              "value": "REDACTED@example.invalid"
            },
            {
              "id": "n-tipo-carga",
              "name": "tipo_carga",
              "type": "string",
              "value": "={{ ((t) => /compl|cami/.test(t) ? \"completa\" : /grup/.test(t) ? \"grupagem\" : \"\")(String($json.tipo_carga ?? $json[\"Tipo de carga\"] ?? \"\").toLowerCase()) }}"
            },
            {
              "id": "n-n-camioes",
              "name": "n_camioes",
              "type": "string",
              "value": "={{ ((v) => v === undefined || v === null || v === \"\" ? \"\" : String(Number(v)))($json.n_camioes ?? $json[\"Nº de camiões\"]) }}"
            },
            {
              "id": "n-n-paletes",
              "name": "n_paletes",
              "type": "string",
              "value": "={{ ((v) => v === undefined || v === null || v === \"\" ? \"\" : String(Number(v)))($json.n_paletes ?? $json[\"Nº de paletes\"]) }}"
            },
            {
              "id": "n-peso-palete",
              "name": "peso_palete_kg",
              "type": "string",
              "value": "={{ ((v) => v === undefined || v === null || v === \"\" ? \"\" : String(Number(v)))($json.peso_palete_kg ?? $json[\"Peso por palete (kg)\"]) }}"
            },
            {
              "id": "n-palete-c",
              "name": "palete_c_m",
              "type": "string",
              "value": "={{ ((v) => v === undefined || v === null || v === \"\" ? \"\" : String(Number(v)))($json.palete_c_m ?? $json[\"Palete: comprimento (m)\"]) }}"
            },
            {
              "id": "n-palete-l",
              "name": "palete_l_m",
              "type": "string",
              "value": "={{ ((v) => v === undefined || v === null || v === \"\" ? \"\" : String(Number(v)))($json.palete_l_m ?? $json[\"Palete: largura (m)\"]) }}"
            },
            {
              "id": "n-palete-a",
              "name": "palete_a_m",
              "type": "string",
              "value": "={{ ((v) => v === undefined || v === null || v === \"\" ? \"\" : String(Number(v)))($json.palete_a_m ?? $json[\"Palete: altura (m)\"]) }}"
            },
            {
              "id": "n-morada-carga",
              "name": "morada_carga",
              "type": "string",
              "value": "={{ String($json.morada_carga ?? $json[\"Morada de carga\"] ?? \"\").trim().slice(0, 300) }}"
            },
            {
              "id": "n-morada-descarga",
              "name": "morada_descarga",
              "type": "string",
              "value": "={{ String($json.morada_descarga ?? $json[\"Morada de descarga\"] ?? \"\").trim().slice(0, 300) }}"
            },
            {
              "id": "n-cp-descarga",
              "name": "cp_descarga",
              "type": "string",
              "value": "={{ String($json.cp_descarga ?? $json[\"Código postal de descarga\"] ?? \"\").trim().toUpperCase().slice(0, 12) }}"
            },
            {
              "id": "n-carga-ok",
              "name": "carga_ok",
              "type": "boolean",
              "value": "={{ (() => { const g = (k, l) => $json[k] ?? $json[l]; const num = (k, l, max, int) => { const v = g(k, l); if (v === undefined || v === null || v === \"\") return true; const n = Number(v); return Number.isFinite(n) && n > 0 && n <= max && (!int || Number.isInteger(n)); }; const t = String(g(\"tipo_carga\", \"Tipo de carga\") ?? \"\").toLowerCase(); return (t === \"\" || /compl|cami|grup/.test(t)) && num(\"n_camioes\", \"Nº de camiões\", 50, true) && num(\"n_paletes\", \"Nº de paletes\", 2000, true) && num(\"peso_palete_kg\", \"Peso por palete (kg)\", 2000) && num(\"palete_c_m\", \"Palete: comprimento (m)\", 3) && num(\"palete_l_m\", \"Palete: largura (m)\", 3) && num(\"palete_a_m\", \"Palete: altura (m)\", 4); })() }}"
            }
          ]
        }
      },
      "notes": "Junta os dois modos de entrada (formulário e chamada por outro workflow). destinatario_confirmacao é o email que recebe a confirmação."
    },
    {
      "id": "52de7d69-761f-4f5a-9a40-0203a7e68ab3",
      "name": "Dados válidos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ !!$json.cliente && !!$json.produto && !!$json.densidade && !!$json.granulometria && !!$json.embalagem && !!$json.destino && $json.quantidade > 0 && [\"EXW\",\"FCA\",\"FAS\",\"FOB\",\"CFR\",\"CIF\",\"CPT\",\"CIP\",\"DAP\",\"DPU\",\"DDP\"].includes($json.incoterm) && $json.carga_ok === true }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "f39c41c9-4ddb-48df-b7c1-d56e230bce27",
      "name": "Criar proposta no Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        672,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "propostas",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "cliente",
              "fieldValue": "={{ $json.cliente }}"
            },
            {
              "fieldId": "produto",
              "fieldValue": "={{ $json.produto }}"
            },
            {
              "fieldId": "densidade",
              "fieldValue": "={{ $json.densidade }}"
            },
            {
              "fieldId": "granulometria",
              "fieldValue": "={{ $json.granulometria }}"
            },
            {
              "fieldId": "quantidade",
              "fieldValue": "={{ $json.quantidade }}"
            },
            {
              "fieldId": "embalagem",
              "fieldValue": "={{ $json.embalagem }}"
            },
            {
              "fieldId": "incoterm",
              "fieldValue": "={{ $json.incoterm }}"
            },
            {
              "fieldId": "destino_pais",
              "fieldValue": "={{ $json.destino }}"
            },
            {
              "fieldId": "tipo_carga",
              "fieldValue": "={{ $json.tipo_carga || null }}"
            },
            {
              "fieldId": "n_camioes",
              "fieldValue": "={{ $json.n_camioes === \"\" ? null : Number($json.n_camioes) }}"
            },
            {
              "fieldId": "n_paletes",
              "fieldValue": "={{ $json.n_paletes === \"\" ? null : Number($json.n_paletes) }}"
            },
            {
              "fieldId": "peso_palete_kg",
              "fieldValue": "={{ $json.peso_palete_kg === \"\" ? null : Number($json.peso_palete_kg) }}"
            },
            {
              "fieldId": "palete_c_m",
              "fieldValue": "={{ $json.palete_c_m === \"\" ? null : Number($json.palete_c_m) }}"
            },
            {
              "fieldId": "palete_l_m",
              "fieldValue": "={{ $json.palete_l_m === \"\" ? null : Number($json.palete_l_m) }}"
            },
            {
              "fieldId": "palete_a_m",
              "fieldValue": "={{ $json.palete_a_m === \"\" ? null : Number($json.palete_a_m) }}"
            },
            {
              "fieldId": "morada_carga",
              "fieldValue": "={{ $json.morada_carga || null }}"
            },
            {
              "fieldId": "morada_descarga",
              "fieldValue": "={{ $json.morada_descarga || null }}"
            },
            {
              "fieldId": "cp_descarga",
              "fieldValue": "={{ $json.cp_descarga || null }}"
            }
          ]
        }
      },
      "retryOnFail": false,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "supabaseApi": {
          "name": "Supabase account"
        }
      }
    },
    {
      "id": "adc2b975-81ea-4426-a490-fe4cdc17e37e",
      "name": "Enviar confirmação do pedido",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "toRecipients": "={{ $(\"Normalizar pedido\").item.json.destinatario_confirmacao }}",
        "subject": "=Pedido de proposta registado – {{ $json.codigo }} – {{ String($json.cliente ?? \"\").slice(0, 60) }}",
        "bodyContent": "={{ ((e) => `<p>Olá,</p><p>O pedido de proposta <b>${e($json.codigo)}</b> foi registado no sistema de propostas. Seguem os dados recebidos:</p><ul><li><b>Número:</b> ${e($json.codigo)}</li><li><b>Cliente:</b> ${e($json.cliente)}</li><li><b>Produto:</b> ${e($json.produto)}</li><li><b>Densidade:</b> ${e($json.densidade)}</li><li><b>Granulometria:</b> ${e($json.granulometria)}</li><li><b>Quantidade:</b> ${e($json.quantidade)} kg</li><li><b>Embalagem:</b> ${e($json.embalagem)}</li><li><b>Incoterm:</b> ${e($json.incoterm)}</li><li><b>Destino:</b> ${e($json.destino_pais)}</li></ul><p>Próximo passo: a equipa comercial revê o pedido antes de qualquer proposta ser enviada ao cliente.</p><p>Cumprimentos,<br>Sistema de propostas (mensagem automática, não responda a este email)</p>`)((s) => String(s ?? \"\").replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\")) }}",
        "additionalFields": {
          "bodyContentType": "html"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "name": "Microsoft Outlook account"
        }
      }
    },
    {
      "id": "fe0dbbb9-3b8b-44ff-bacf-4a6d09bb349c",
