              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "60-80 kg/m3"
                  },
                  {
                    "option": "80-100 kg/m3"
                  },
                  {
                    "option": "100-120 kg/m3"
                  },
                  {
                    "option": "120-150 kg/m3"
                  }
                ]
              }
            },
            {
              "fieldName": "granulometria",
