              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true,
          "value": {
            "codigo": "={{ $(\"Conferir gravação\").first().json.codigo }}"
          }
        },
        "options": {
          "waitForSubWorkflow": false
        }
      },
      "executeOnce": true,
      "notes": "Não espera; o WF12 tem o seu próprio aviso de erro."
    }
  ],
