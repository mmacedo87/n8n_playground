    {
      "id": "64d423cf-11cc-4c9b-b9c4-2cb7ac2fd84c",
      "name": "Resolver regra",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        -100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const p = $('Ler proposta').first().json;\nconst prod = $('Ler produto').first().json || {};\nconst regras = $('Ler regras do país').all().map(i => i.json).filter(r => r && r.id);\nconst nc = prod.codigo_nc || null;\nconst regra = regras.find(r => r.codigo_pautal === nc) || regras.find(r => r.codigo_pautal === '*') || null;\nconst semRegra = 'Sem regra registada para este destino: verificar manualmente.';\nconst usaUsitc = !!regra && regra.metodo === 'api_usitc' && !!prod.hts_us;\nreturn [{ json: {\n  proposta_id: p.id,\n  codigo: p.codigo,\n  destino_pais: p.destino_pais,\n  produto: p.produto,\n  codigo_nc: nc,\n  hts_us: prod.hts_us || null,\n  produto_validado: prod.validado === true,\n  metodo: regra ? regra.metodo : 'tabela_manual',\n  taxa_pct: regra && regra.taxa_direitos_pct !== null && regra.taxa_direitos_pct !== undefined ? Number(regra.taxa_direitos_pct) : null,\n  notas_taxas: regra ? regra.notas_taxas : semRegra,\n  fito: regra ? regra.requisitos_fitossanitarios : semRegra,\n  fonte: regra ? regra.fonte : null,\n  usa_usitc: usaUsitc\n} }];"
      }
    },
    {
      "id": "28da7077-3025-4629-b2a6-fb60947edd06",
      "name": "Consultar USITC?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1568,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.usa_usitc }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "e051690e-15b8-45a6-9390-26746d60a55a",
      "name": "Consultar tabela HTS (USITC)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1792,
        -200
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://hts.usitc.gov/reststop/search?keyword={{ $json.hts_us }}",
        "authentication": "none",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "d500f152-3d49-4b1e-a659-da25eb3eb87e",
      "name": "Montar compliance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        -100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const base = $('Resolver regra').first().json;\nlet metodo = base.metodo;\nlet estado = metodo === 'tabela_manual' ? 'a_verificar_manualmente' : 'automatico';\nlet taxaPct = base.taxa_pct;\nlet taxaTexto = null;\nlet notas = base.notas_taxas;\nif (base.metodo === 'api_usitc' && !base.usa_usitc) {\n  metodo = 'tabela_manual';\n  estado = 'a_verificar_manualmente';\n  notas = 'Produto sem código HTS registado: taxa não consultada. ' + base.notas_taxas;\n}\nif (base.usa_usitc) {\n  let linha = null;\n  const itens = $input.all().map(i => i.json);\n  const lista = itens.length === 1 && Array.isArray(itens[0]) ? itens[0] : itens;\n  for (const x of lista) { if (x && x.htsno === base.hts_us) { linha = x; break; } }\n  if (linha && linha.general !== null && linha.general !== undefined && String(linha.general).trim() !== '') {\n    taxaTexto = String(linha.general).trim();\n    const m = taxaTexto.match(/^([0-9]+(?:[.][0-9]+)?)%$/);\n    taxaPct = /^free$/i.test(taxaTexto) ? 0 : (m ? Number(m[1]) : null);\n    notas = 'HTS ' + base.hts_us + ' (USITC): taxa base (coluna geral) = ' + taxaTexto + '. Não inclui direitos adicionais em vigor para a origem; confirmar com o transitário.';\n  } else {\n    metodo = 'tabela_manual';\n    estado = 'a_verificar_manualmente';\n    notas = 'Não foi possível ler a taxa no USITC para o HTS ' + base.hts_us + '. ' + base.notas_taxas;\n  }\n}\nif (!base.codigo_nc) {\n  estado = 'a_verificar_manualmente';\n  notas = 'Produto sem código pautal registado na tabela produtos. ' + notas;\n} else if (!base.produto_validado) {\n  notas = notas + ' (Código pautal ' + base.codigo_nc + ' ainda não validado pelo despachante.)';\n}\nreturn [{ json: {\n  proposta_id: base.proposta_id,\n  destino_pais: base.destino_pais,\n  codigo_nc: base.codigo_nc,\n  hts_us: base.hts_us,\n  taxa_direitos_pct: taxaPct,\n  taxa_texto: taxaTexto,\n  notas_taxas: notas,\n  requisitos_fitossanitarios: base.fito,\n  fonte: base.fonte,\n  metodo: metodo,\n  estado: estado\n} }];"
      }
    },
