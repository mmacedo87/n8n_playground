{
  "name": "WF4 - Enriquecimento de proposta",
  "description": "Para uma proposta registada (código PRP), grava em proposta_compliance o código pautal, a taxa por destino (UE por regra, EUA via USITC, restantes manual) e as notas fitossanitárias. Sem LLM. Entrada: codigo (chamado pelo WF2).",
  "nodes": [
    {
      "id": "1f0dc144-21de-4353-87e7-1794aea464ca",
      "name": "Chamado pelo WF2",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "codigo"
            }
          ]
        }
      }
    },
    {
