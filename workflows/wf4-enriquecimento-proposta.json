      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "propostas",
        "limit": 1,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "codigo",
              "condition": "eq",
              "keyValue": "={{ $json.codigo }}"
            }
          ]
        }
      },
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "name": "Supabase account"
        }
      }
    },
    {
      "id": "47bbe85c-0446-4a8c-b34f-a15b7a8e4b5f",
      "name": "Proposta existe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
