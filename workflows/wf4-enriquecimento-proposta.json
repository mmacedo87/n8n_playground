    {
      "id": "5dc2e0d5-fb13-4e3b-87e5-847ab19e2528",
      "name": "Sticky Note aecb1579",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "content": "## WF4 - Enriquecimento\nPor cada proposta: código pautal do produto + taxa por destino + notas fitossanitárias. UE: regra (circulação intra-UE). EUA: taxa base lida no USITC. Restantes destinos: tabela de referência com estado \"a_verificar_manualmente\". SEM LLM nesta versão: não há fonte estruturada fiável para requisitos sanitários. Tudo fica gravado em proposta_compliance, para validação da Bárbara no passo 6.",
        "color": 3,
        "width": 520,
        "height": 200
      }
    }
