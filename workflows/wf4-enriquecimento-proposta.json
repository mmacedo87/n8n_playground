    },
    {
      "id": "b4d4d803-baa1-42ec-9ae7-352a6258fffe",
      "name": "Ler regras do país",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1120,
        -100
      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "requisitos_pais",
        "returnAll": true,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "pais_iso",
              "condition": "eq",
              "keyValue": "={{ $(\"Ler proposta\").first().json.destino_pais }}"
            }
          ]
        }
