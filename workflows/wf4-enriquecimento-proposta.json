    },
    {
      "id": "34f15b30-3941-49ee-8849-4825eb42272c",
      "name": "Ler produto",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        896,
        -100
      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "produtos",
        "limit": 1,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "produto",
              "condition": "eq",
              "keyValue": "={{ $(\"Ler proposta\").first().json.produto }}"
