    {
      "parameters": {
        "jsCode": "return $input.all().map(i => {\n  const m = i.json;\n  const html = String((m.body && m.body.content) || m.bodyPreview || '');\n  const texto = html.replace(/<style[\\s\\S]*?<\\/style>/gi, ' ').replace(/<br\\s*\\/?>|<\\/p>|<\\/div>/gi, '\\n').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/[ \\t]+/g, ' ').replace(/\\n\\s*\\n+/g, '\\n').trim().slice(0, 6000);\n  const de = (m.from && m.from.emailAddress) || {};\n  return { json: { email_id: m.id, assunto: String(m.subject || '').slice(0, 200), remetente_email: String(de.address || '').toLowerCase(), remetente_nome: String(de.name || '').slice(0, 120), texto } };\n});"
      },
