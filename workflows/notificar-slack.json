{
  "name": "Notificar Slack",
  "description": "Sub-workflow reutilizável: publica uma mensagem curta num canal do Slack (propostas, cotacoes ou estado). Entradas: canal, texto. Chamado pelo WF2 e pelo WF3.",
  "nodes": [
    {
      "id": "afa8b513-be2c-4217-bf55-4f5f62258e7b",
      "name": "Chamado por outro workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "canal",
              "type": "string"
            },
            {
              "name": "texto",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "cec1daae-ce1c-49a6-be9c-fbe4480eea08",
      "name": "Escolher canal e texto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const CANAIS = { propostas: 'C0C7T8J8D54', cotacoes: 'C0C7V2PU4PL', estado: 'C0C7SN9MKQE' };\nconst b = $input.first().json;\nconst canal = String(b.canal || '').trim();\nif (!CANAIS[canal]) throw new Error('Canal desconhecido: ' + canal + ' (use propostas, cotacoes ou estado).');\nconst texto = String(b.texto || '').trim();\nif (!texto) throw new Error('Texto vazio.');\nconst esc = (v) => v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nreturn [{ json: { canal_id: CANAIS[canal], texto: esc(texto).slice(0, 3000) } }];"
      }
    },
    {
      "id": "12004f75-660b-4185-8fa4-1ca32f091656",
      "name": "Publicar no Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        480,
        0
      ],
      "parameters": {
        "authentication": "accessToken",
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.canal_id }}"
        },
        "messageType": "text",
        "text": "={{ $json.texto }}",
        "otherOptions": {
          "includeLinkToWorkflow": false,
          "mrkdwn": true,
          "unfurl_links": false,
          "unfurl_media": false
        }
      },
      "credentials": {
        "slackApi": {
          "name": "Slack API"
        }
      }
    }
  ],
  "connections": {
    "Chamado por outro workflow": {
      "main": [
        [
          {
            "node": "Escolher canal e texto",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Escolher canal e texto": {
      "main": [
        [
          {
            "node": "Publicar no Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true,
    "errorWorkflow": "{{WF:Mail Error Flow}}",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    {
      "name": "subworkflow"
    },
    {
      "name": "propostas"
    }
  ],
  "meta": {
    "exportedFrom": "n8n Cloud (DEV)",
    "sourceWorkflowId": "N7BZddGLl0WlSl9Q",
    "sourceVersionId": "23247056-576f-4563-b0ae-7a1e3fd26395",
    "exportedAt": "2026-10-08",
    "sanitized": "ids de credenciais, errorWorkflow e webhookIds removidos; os ids dos canais Slack ficam no código (adaptar em produção)"
  }
}
